{
  "$schema": "https://json.schemastore.org/claude-code-marketplace.json",
  "name": "agentic-harness",
  "description": "A plug-and-play catalogue of Claude Code packs: skills, agents, workflows, hooks and mods. Enable only what a project needs.",
  "owner": {
    "name": "Parth Komalwad",
    "url": "https://github.com/Parthkomalwad"
  },
  "metadata": {
    "pluginRoot": "./plugins"
  },
  "plugins": [
    {
      "name": "core",
      "source": "./plugins/core",
      "description": "Always-on base: lean-code rules, and the packs skill that finds and enables the right packs for your problem.",
      "category": "core",
      "tags": [
        "core"
      ],
      "defaultEnabled": true,
      "metadata": {
        "intents": [
          "too many plugins loaded",
          "which pack should I use",
          "set up the harness for this project",
          "keep code minimal"
        ],
        "group": "Foundation",
        "hero": "on"
      }
    },
    {
      "name": "ui-pack",
      "source": "./plugins/ui-pack",
      "description": "UI without the AI look: DESIGN.md style, curated shadcn registries, build, screenshot, audit, fix.",
      "category": "ui",
      "tags": [
        "ui",
        "design",
        "shadcn"
      ],
      "defaultEnabled": false,
      "metadata": {
        "intents": [
          "build a landing page",
          "my UI looks generic or AI-made",
          "redesign this page",
          "need a dashboard or hero section",
          "pick components"
        ],
        "group": "Build",
        "try": "build a dashboard in the Vercel style",
        "hero": "on"
      },
      "relevance": {
        "topic": "UI design",
        "signals": {
          "filesRead": [
            "**/components.json",
            "**/tailwind.config.*",
            "**/*.tsx"
          ],
          "manifestDeps": [
            {
              "file": "[/\\\\]package\\.json$",
              "pattern": "\"(react|next|tailwindcss)\"\\s*:"
            }
          ]
        }
      }
    },
    {
      "name": "motion-pack",
      "source": "./plugins/motion-pack",
      "description": "Motion design in code: launch videos and reels rendered frame by frame, with a self-critique loop.",
      "category": "media",
      "tags": [
        "motion",
        "video",
        "animation"
      ],
      "defaultEnabled": false,
      "metadata": {
        "intents": [
          "make a launch video",
          "product promo or showreel",
          "animated explainer",
          "motion graphics in code"
        ],
        "group": "Build",
        "try": "make a 20s vertical launch video for <url>",
        "hero": "off"
      },
      "relevance": {
        "topic": "motion video",
        "signals": {
          "cli": [
            "ffmpeg"
          ],
          "filesRead": [
            "**/render.mjs",
            "**/beats.json"
          ]
        }
      }
    },
    {
      "name": "docs-pack",
      "source": "./plugins/docs-pack",
      "description": "Create, restructure or update a README that explains the project clearly and looks good on GitHub.",
      "category": "docs",
      "tags": [
        "readme",
        "docs"
      ],
      "defaultEnabled": false,
      "metadata": {
        "intents": [
          "write a README",
          "my README is unclear",
          "improve project docs",
          "make the repo look good on GitHub"
        ],
        "group": "Build",
        "try": "rewrite this README so people get it in 10 seconds",
        "hero": "off"
      },
      "relevance": {
        "topic": "READMEs",
        "signals": {
          "filesRead": [
            "**/README.md"
          ]
        }
      }
    },
    {
      "name": "deploy-pack",
      "source": "./plugins/deploy-pack",
      "description": "Deployment strategist: audits a project, recommends the cheapest fitting stack with cost estimates and an exit plan.",
      "category": "ops",
      "tags": [
        "deploy",
        "hosting",
        "cost"
      ],
      "defaultEnabled": false,
      "metadata": {
        "intents": [
          "where should I deploy this",
          "hosting is too expensive",
          "S3 or R2",
          "static site hosting",
          "pick a database host"
        ],
        "group": "Ship",
        "try": "where should I deploy this, cheaply?",
        "hero": "on"
      },
      "relevance": {
        "topic": "deployment",
        "signals": {
          "cli": [
            "vercel",
            "wrangler",
            "netlify",
            "flyctl",
            "aws",
            "terraform"
          ],
          "filesRead": [
            "**/Dockerfile",
            "**/wrangler.toml",
            "**/vercel.json",
            "**/render.yaml",
            "**/fly.toml"
          ]
        }
      }
    },
    {
      "name": "council-pack",
      "source": "./plugins/council-pack",
      "description": "LLM council made of Claude agents: independent answers, anonymous peer ranking, chairman synthesis.",
      "category": "thinking",
      "tags": [
        "council",
        "decision",
        "multi-agent"
      ],
      "defaultEnabled": false,
      "metadata": {
        "intents": [
          "help me decide between options",
          "get several opinions on this",
          "stress-test my plan",
          "hard architecture or product decision"
        ],
        "group": "Decide",
        "try": "/council-pack:council Postgres or DynamoDB for this?",
        "hero": "off"
      }
    },
    {
      "name": "architect-pack",
      "source": "./plugins/architect-pack",
      "description": "System and product design partner: requirements, options, Well-Architected pillar review, design artifacts. Also uploadable to claude.ai.",
      "category": "thinking",
      "tags": [
        "architecture",
        "system-design",
        "product"
      ],
      "defaultEnabled": false,
      "metadata": {
        "intents": [
          "design the architecture for my product",
          "plan a new system",
          "review my design",
          "brainstorm a product idea"
        ],
        "group": "Decide",
        "try": "design the architecture for a booking app",
        "hero": "on"
      }
    },
    {
      "name": "superpowers",
      "source": {
        "source": "github",
        "repo": "obra/superpowers"
      },
      "description": "Upstream: brainstorm, plan, TDD, subagent execution and review methodology.",
      "category": "external",
      "tags": [
        "methodology",
        "tdd"
      ],
      "defaultEnabled": false,
      "metadata": {
        "intents": [
          "plan before coding",
          "use TDD",
          "structured development method",
          "brainstorm a feature"
        ],
        "group": "Upstream",
        "hero": "off"
      }
    },
    {
      "name": "taste-skill",
      "source": {
        "source": "github",
        "repo": "Leonxlnx/taste-skill"
      },
      "description": "Upstream: art direction for frontend work, image-to-code, redesign and style skills.",
      "category": "external",
      "tags": [
        "ui",
        "design"
      ],
      "defaultEnabled": false,
      "metadata": {
        "intents": [
          "better visual taste",
          "art direction for UI",
          "turn a screenshot into code"
        ],
        "group": "Upstream",
        "hero": "on"
      }
    },
    {
      "name": "playwright-cli",
      "source": {
        "source": "git-subdir",
        "url": "microsoft/playwright-cli",
        "path": "skills/playwright-cli"
      },
      "description": "Upstream: token-efficient browser automation. Needs `npm i -g @playwright/cli`.",
      "category": "external",
      "tags": [
        "ui",
        "testing",
        "browser"
      ],
      "defaultEnabled": false,
      "metadata": {
        "intents": [
          "take screenshots of my site",
          "test in a real browser",
          "automate a browser"
        ],
        "group": "Upstream",
        "hero": "on"
      },
      "relevance": {
        "topic": "browser automation",
        "signals": {
          "cli": [
            "playwright",
            "playwright-cli"
          ]
        }
      }
    },
    {
      "name": "web-design-guidelines",
      "source": {
        "source": "git-subdir",
        "url": "vercel-labs/agent-skills",
        "path": "skills/web-design-guidelines"
      },
      "description": "Upstream: Vercel's ~100-rule UI audit for accessibility, UX and performance.",
      "category": "external",
      "tags": [
        "ui",
        "audit",
        "a11y"
      ],
      "defaultEnabled": false,
      "metadata": {
        "intents": [
          "audit my UI",
          "check accessibility",
          "review UX"
        ],
        "group": "Upstream"
      }
    }
  ]
}
