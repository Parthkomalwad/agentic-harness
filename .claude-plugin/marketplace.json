{
  "$schema": "https://json.schemastore.org/claude-code-marketplace.json",
  "name": "agentic-harness",
  "description": "A plug-and-play catalogue of Claude Code packs: skills, agents, workflows, hooks and mods. Enable only what a project needs.",
  "owner": {
    "name": "Parth Komalwad",
    "url": "https://github.com/Parthkomalwad"
  },
  "metadata": {
    "pluginRoot": "./plugins"
  },
  "plugins": [
    {
      "name": "core",
      "source": "./plugins/core",
      "description": "Always-on base: lean-code rules, the packs skill that finds and enables the right packs, and a band above the prompt showing active packs, context and cost.",
      "category": "core",
      "tags": [
        "core"
      ],
      "defaultEnabled": true,
      "metadata": {
        "intents": [
          "too many plugins loaded",
          "which pack should I use",
          "set up the harness for this project",
          "keep code minimal"
        ],
        "group": "Foundation",
        "hero": "on"
      }
    },
    {
      "name": "ui-pack",
      "source": "./plugins/ui-pack",
      "description": "UI without the AI look: DESIGN.md style, curated shadcn registries, build, screenshot, audit, fix.",
      "category": "ui",
      "tags": [
        "ui",
        "design",
        "shadcn"
      ],
      "defaultEnabled": false,
      "metadata": {
        "intents": [
          "build a landing page",
          "my UI looks generic or AI-made",
          "redesign this page",
          "need a dashboard or hero section",
          "pick components"
        ],
        "group": "Build",
        "try": "build a dashboard in the Vercel style",
        "hero": "on"
      },
      "relevance": {
        "topic": "UI design",
        "signals": {
          "filesRead": [
            "**/components.json",
            "**/tailwind.config.*",
            "**/*.tsx"
          ],
          "manifestDeps": [
            {
              "file": "[/\\\\]package\\.json$",
              "pattern": "\"(react|next|tailwindcss)\"\\s*:"
            }
          ]
        }
      }
    },
    {
      "name": "motion-pack",
      "source": "./plugins/motion-pack",
      "description": "Motion design in code: launch videos and reels rendered frame by frame, with a self-critique loop.",
      "category": "media",
      "tags": [
        "motion",
        "video",
        "animation"
      ],
      "defaultEnabled": false,
      "metadata": {
        "intents": [
          "make a launch video",
          "product promo or showreel",
          "animated explainer",
          "motion graphics in code"
        ],
        "group": "Build",
        "try": "make a 20s vertical launch video for <url>",
        "hero": "off"
      },
      "relevance": {
        "topic": "motion video",
        "signals": {
          "cli": [
            "ffmpeg"
          ],
          "filesRead": [
            "**/render.mjs",
            "**/beats.json"
          ]
        }
      }
    },
    {
      "name": "docs-pack",
      "source": "./plugins/docs-pack",
      "description": "Create, restructure or update a README that explains the project clearly and looks good on GitHub.",
      "category": "docs",
      "tags": [
        "readme",
        "docs"
      ],
      "defaultEnabled": false,
      "metadata": {
        "intents": [
          "write a README",
          "my README is unclear",
          "improve project docs",
          "make the repo look good on GitHub"
        ],
        "group": "Build",
        "try": "rewrite this README so people get it in 10 seconds",
        "hero": "off"
      },
      "relevance": {
        "topic": "READMEs",
        "signals": {
          "filesRead": [
            "**/README.md"
          ]
        }
      }
    },
    {
      "name": "deploy-pack",
      "source": "./plugins/deploy-pack",
      "description": "Deployment strategist: audits a project, recommends the cheapest fitting stack with cost estimates and an exit plan.",
      "category": "ops",
      "tags": [
        "deploy",
        "hosting",
        "cost"
      ],
      "defaultEnabled": false,
      "metadata": {
        "intents": [
          "where should I deploy this",
          "hosting is too expensive",
          "S3 or R2",
          "static site hosting",
          "pick a database host"
        ],
        "group": "Ship",
        "try": "where should I deploy this, cheaply?",
        "hero": "on"
      },
      "relevance": {
        "topic": "deployment",
        "signals": {
          "cli": [
            "vercel",
            "wrangler",
            "netlify",
            "flyctl",
            "aws",
            "terraform"
          ],
          "filesRead": [
            "**/Dockerfile",
            "**/wrangler.toml",
            "**/vercel.json",
            "**/render.yaml",
            "**/fly.toml"
          ]
        }
      }
    },
    {
      "name": "council-pack",
      "source": "./plugins/council-pack",
      "description": "LLM council made of Claude agents: independent answers, anonymous peer ranking, chairman synthesis.",
      "category": "thinking",
      "tags": [
        "council",
        "decision",
        "multi-agent"
      ],
      "defaultEnabled": false,
      "metadata": {
        "intents": [
          "help me decide between options",
          "get several opinions on this",
          "stress-test my plan",
          "hard architecture or product decision"
        ],
        "group": "Decide",
        "try": "/council-pack:council Postgres or DynamoDB for this?",
        "hero": "off"
      }
    },
    {
      "name": "architect-pack",
      "source": "./plugins/architect-pack",
      "description": "System and product design partner: requirements, options, Well-Architected pillar review, design artifacts. Also uploadable to claude.ai.",
      "category": "thinking",
      "tags": [
        "architecture",
        "system-design",
        "product"
      ],
      "defaultEnabled": false,
      "metadata": {
        "intents": [
          "design the architecture for my product",
          "plan a new system",
          "review my design",
          "brainstorm a product idea"
        ],
        "group": "Decide",
        "try": "design the architecture for a booking app",
        "hero": "on"
      }
    },
    {
      "name": "glassbox",
      "source": "./plugins/glassbox",
      "description": "Open the black box: record why each decision was made, map how the code flows, and quiz yourself before accepting a change.",
      "category": "decide",
      "tags": [
        "transparency",
        "decisions",
        "learning"
      ],
      "defaultEnabled": false,
      "metadata": {
        "group": "Decide",
        "try": "explain what you just built and quiz me on it",
        "intents": [
          "I do not understand the code Claude wrote",
          "why was this decision made",
          "explain how this code flows",
          "quiz me before I accept this change"
        ]
      }
    },
    {
      "name": "system-one",
      "source": "./plugins/system-one",
      "description": "Cheap small models for typed judgments (TypeSafe Jev) and extraction or summaries (ScaleDown), so the big model only decides.",
      "category": "foundation",
      "tags": [
        "jev",
        "scaledown",
        "cost"
      ],
      "defaultEnabled": false,
      "metadata": {
        "group": "Foundation",
        "try": "summarize this 40 page PDF cheaply before you read it",
        "intents": [
          "this file is too big to read",
          "make a cheap yes or no judgment",
          "classify these items",
          "reduce token cost"
        ]
      }
    },
    {
      "name": "research-pack",
      "source": "./plugins/research-pack",
      "description": "Research across the web, GitHub, Reddit, X and YouTube with Agent Reach, cross-checked and cited.",
      "category": "decide",
      "tags": [
        "research",
        "agent-reach",
        "sources"
      ],
      "defaultEnabled": false,
      "metadata": {
        "group": "Decide",
        "try": "research what developers say about Bun vs Node in 2026",
        "intents": [
          "research this topic",
          "what are people saying about X",
          "find sources and cite them",
          "compare tools with real opinions"
        ]
      },
      "relevance": {
        "topic": "research",
        "signals": {
          "cli": [
            "agent-reach"
          ]
        }
      }
    },
    {
      "name": "orchestrator",
      "source": "./plugins/orchestrator",
      "description": "Sweep a codebase with a dynamic workflow: cheap agents scan, stronger agents fix in isolated copies, a verifier keeps only proven changes.",
      "category": "build",
      "tags": [
        "workflow",
        "multi-agent",
        "sweep"
      ],
      "defaultEnabled": false,
      "metadata": {
        "group": "Build",
        "try": "/orchestrator:sweep missing auth checks in src/routes",
        "intents": [
          "fix this across the whole codebase",
          "audit every file for X",
          "large refactor or migration",
          "run many agents in parallel"
        ]
      }
    },
    {
      "name": "test-pack",
      "source": "./plugins/test-pack",
      "description": "Write the tests a change needs, find flaky tests, and loop on fixes until the suite is green.",
      "category": "ship",
      "tags": [
        "testing",
        "tdd",
        "ci"
      ],
      "defaultEnabled": false,
      "metadata": {
        "group": "Ship",
        "try": "write tests for the change I just made",
        "intents": [
          "write tests for this",
          "my tests are flaky",
          "CI is red, make it green",
          "what is untested here"
        ]
      },
      "relevance": {
        "topic": "testing",
        "signals": {
          "cli": [
            "pytest",
            "jest",
            "vitest",
            "go",
            "cargo"
          ]
        }
      }
    },
    {
      "name": "security-pack",
      "source": "./plugins/security-pack",
      "description": "Secret and dependency checks, an OWASP review of a diff, and a guard that asks before dangerous shell commands run.",
      "category": "ship",
      "tags": [
        "security",
        "owasp",
        "guard"
      ],
      "defaultEnabled": false,
      "metadata": {
        "group": "Ship",
        "try": "security review my diff before I push",
        "intents": [
          "is this code secure",
          "check for leaked secrets",
          "audit my dependencies",
          "stop dangerous commands"
        ]
      }
    },
    {
      "name": "db-pack",
      "source": "./plugins/db-pack",
      "description": "Schema design, safe zero-downtime migrations, and index review for Postgres, MySQL and SQLite.",
      "category": "build",
      "tags": [
        "database",
        "migrations",
        "postgres"
      ],
      "defaultEnabled": false,
      "metadata": {
        "group": "Build",
        "try": "design the schema for a multi-tenant booking app",
        "intents": [
          "design my database schema",
          "write a safe migration",
          "this query is slow",
          "add an index"
        ]
      },
      "relevance": {
        "topic": "databases",
        "signals": {
          "cli": [
            "psql",
            "prisma",
            "drizzle-kit",
            "alembic"
          ],
          "filesRead": [
            "**/schema.prisma",
            "**/migrations/**",
            "**/*.sql"
          ]
        }
      }
    },
    {
      "name": "observability-pack",
      "source": "./plugins/observability-pack",
      "description": "Add structured logs, health checks, metrics and error tracking so production problems are visible and debuggable.",
      "category": "ship",
      "tags": [
        "observability",
        "logging",
        "opentelemetry"
      ],
      "defaultEnabled": false,
      "metadata": {
        "group": "Ship",
        "try": "add logging and error tracking to this API",
        "intents": [
          "I cannot debug production",
          "add logging",
          "add monitoring and alerts",
          "set up error tracking"
        ]
      }
    },
    {
      "name": "ship-pack",
      "source": "./plugins/ship-pack",
      "description": "Branch, commit, open a PR and write release notes the way this repo wants, following its CLAUDE.md and CONTRIBUTING rules.",
      "category": "ship",
      "tags": [
        "git",
        "pull-request",
        "release"
      ],
      "defaultEnabled": false,
      "metadata": {
        "group": "Ship",
        "try": "commit this and open a PR",
        "intents": [
          "commit and open a PR",
          "write release notes",
          "what branch name should I use",
          "prepare a release"
        ]
      }
    },
    {
      "name": "launch-pack",
      "source": "./plugins/launch-pack",
      "description": "Turn a finished project into a launch: README polish, a launch video, a blog post and social posts, all from the real code.",
      "category": "ship",
      "tags": [
        "launch",
        "marketing",
        "blog"
      ],
      "defaultEnabled": false,
      "metadata": {
        "group": "Ship",
        "try": "help me launch this project",
        "intents": [
          "help me launch this project",
          "write a blog post about my repo",
          "write a launch tweet",
          "announce my release"
        ]
      }
    },
    {
      "name": "superpowers",
      "source": {
        "source": "github",
        "repo": "obra/superpowers"
      },
      "description": "Upstream: brainstorm, plan, TDD, subagent execution and review methodology.",
      "category": "external",
      "tags": [
        "methodology",
        "tdd"
      ],
      "defaultEnabled": false,
      "metadata": {
        "intents": [
          "plan before coding",
          "use TDD",
          "structured development method",
          "brainstorm a feature"
        ],
        "group": "Upstream",
        "hero": "off"
      }
    },
    {
      "name": "taste-skill",
      "source": {
        "source": "github",
        "repo": "Leonxlnx/taste-skill"
      },
      "description": "Upstream: art direction for frontend work, image-to-code, redesign and style skills.",
      "category": "external",
      "tags": [
        "ui",
        "design"
      ],
      "defaultEnabled": false,
      "metadata": {
        "intents": [
          "better visual taste",
          "art direction for UI",
          "turn a screenshot into code"
        ],
        "group": "Upstream",
        "hero": "on"
      }
    },
    {
      "name": "playwright-cli",
      "source": {
        "source": "git-subdir",
        "url": "microsoft/playwright-cli",
        "path": "skills/playwright-cli"
      },
      "description": "Upstream: token-efficient browser automation. Needs `npm i -g @playwright/cli`.",
      "category": "external",
      "tags": [
        "ui",
        "testing",
        "browser"
      ],
      "defaultEnabled": false,
      "metadata": {
        "intents": [
          "take screenshots of my site",
          "test in a real browser",
          "automate a browser"
        ],
        "group": "Upstream",
        "hero": "on"
      },
      "relevance": {
        "topic": "browser automation",
        "signals": {
          "cli": [
            "playwright",
            "playwright-cli"
          ]
        }
      }
    },
    {
      "name": "web-design-guidelines",
      "source": {
        "source": "git-subdir",
        "url": "vercel-labs/agent-skills",
        "path": "skills/web-design-guidelines"
      },
      "description": "Upstream: Vercel's ~100-rule UI audit for accessibility, UX and performance.",
      "category": "external",
      "tags": [
        "ui",
        "audit",
        "a11y"
      ],
      "defaultEnabled": false,
      "metadata": {
        "intents": [
          "audit my UI",
          "check accessibility",
          "review UX"
        ],
        "group": "Upstream"
      }
    }
  ]
}
